# OpsVista authentication configuration
# Never commit real values. Configure these only in the deployment environment.

# Minimum 32 characters. Used to sign the HttpOnly session cookie.
OPSVISTA_SESSION_SECRET=

# One-time Founder account activation secret. Production only; remove after Founder activation.
# Rotate it if the value is ever exposed outside the deployment environment.
OPSVISTA_FOUNDER_BOOTSTRAP_SECRET=

# JSON array used for credential verification/bootstrap. Passwords are NEVER stored directly.
# passwordHash must be a 64-byte scrypt hash encoded as hex.
OPSVISTA_AUTH_USERS_JSON=

# Central OpsVista management data store (PostgreSQL-compatible connection string).
# Production is expected to receive this from the Vercel/Neon integration.
# Stores managed user access records and append-only management audit history.
OPSVISTA_DATABASE_URL=

# OpsVista Ramp live-data configuration
RAMP_CLIENT_ID=
RAMP_CLIENT_SECRET=
RAMP_TOKEN_URL=https://api.ramp.com/developer/v1/token
RAMP_API_BASE_URL=https://api.ramp.com/developer/v1
RAMP_SCOPES=transactions:read

# Minimum read scopes for OpsVista Ramp Compliance:
# transactions:read users:read departments:read locations:read memos:read receipts:read
RAMP_ACCESS_TOKEN=

# Real weekly salaried labor cost by restaurant. The API prorates this amount to the selected date range.
# Example only — configure real values in Vercel, never in source control.
OPSVISTA_WEEKLY_SALARY_LABOR_JSON=
# Private per-employee schedule corrections keyed by employee name. Supports location, role, employmentType and hourlyWage.
OPSVISTA_SCHEDULE_EMPLOYEE_OVERRIDES_JSON=

# Toast Standard API — production values must be configured in Vercel.
TOAST_API_HOST=https://ws-api.toasttab.com
TOAST_CLIENT_ID=
TOAST_CLIENT_SECRET=
# JSON object mapping restaurant name to its Toast restaurant GUID.
TOAST_LOCATION_GUIDS_JSON=

# 7shifts — use a production access token or OAuth client credentials.
SEVENSHIFTS_ACCESS_TOKEN=
SEVENSHIFTS_COMPANY_ID=
SEVENSHIFTS_CLIENT_ID=
SEVENSHIFTS_CLIENT_SECRET=

# Local Intelligence — server-side only. Never expose these keys in VITE_* variables.
TOMTOM_API_KEY=
TICKETMASTER_API_KEY=
WEATHER_COMPANY_API_KEY=
