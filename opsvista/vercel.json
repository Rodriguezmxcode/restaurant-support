{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/payments", "destination": "/api/workflows?resource=payments" },
    { "source": "/api/tasks/weekly", "destination": "/api/workflows?resource=tasks" },
    { "source": "/api/local-intelligence", "destination": "/api/workflows?resource=local_intelligence" }
  ]
}
