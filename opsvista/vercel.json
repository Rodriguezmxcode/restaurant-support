{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/integrations/google-business/callback", "destination": "/api/workflows?resource=google_business_callback" },
    { "source": "/api/integrations/google-business", "destination": "/api/workflows?resource=google_business_integration" },
    { "source": "/api/integrations/restaurant365", "destination": "/api/workflows?resource=restaurant365_integration" },
    { "source": "/api/payments", "destination": "/api/workflows?resource=payments" },
    { "source": "/api/tasks/weekly", "destination": "/api/workflows?resource=tasks" },
    { "source": "/api/google-business/reviews", "destination": "/api/workflows?resource=google_reviews" },
    { "source": "/api/local-intelligence", "destination": "/api/workflows?resource=local_intelligence" }
  ]
}
